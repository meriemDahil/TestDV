class TestBucketedChecksum:

    def test_identical_datasets_no_bucket_issues(self, base_df, cfg):
        result = layer.run(base_df, base_df.copy(), cfg)
        c = check(result, "bucketed_checksum")
        assert c.status == Status.PASSED
        assert c.details["mismatched_buckets"] == []

    def test_changed_value_causes_bucket_mismatch(self, base_df, cfg):
        tgt = base_df.copy()
        tgt.loc[0, "score"] = 99.9
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "bucketed_checksum")
        assert c.status == Status.FAILED
        assert len(c.details["mismatched_buckets"]) >= 1

    def test_bucket_mismatch_details_structure(self, base_df, cfg):
        tgt = base_df.copy()
        tgt.loc[0, "name"] = "CHANGED"
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "bucketed_checksum")
        for b in c.details["mismatched_buckets"]:
            assert "bucket"       in b
