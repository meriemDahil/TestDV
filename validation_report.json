"""
Unit tests for Layer 1 – Structural Validation.

Coverage:
  1. column_count       – match / mismatch
  2. column_names       – match / missing / extra / both
  3. data_types         – compatible / mismatched families / same family different dtype
  4. null_counts        – match / mismatch (single + multiple columns)
  5. column_order       – enabled+match / enabled+mismatch / disabled
  6. early-exit         – column-name failure stops dtype & null checks
"""
from __future__ import annotations

from unittest.mock import MagicMock

import pandas as pd
import pytest

from core.models import Status, ValidationConfig
from layers import layer_1_structural as layer


# ── Helpers ──────────────────────────────────────────────────────────────────

def make_config(
    check_column_order: bool = False,
    source_label: str = "source",
    target_label: str = "target",
) -> ValidationConfig:
    cfg = MagicMock(spec=ValidationConfig)
    cfg.check_column_order = check_column_order
    cfg.source_label = source_label
    cfg.target_label = target_label
    return cfg


def check(result, name: str):
    """Return the CheckResult with the given check_name."""
    for c in result.checks:
        if c.check_name == name:
            return c
    raise KeyError(f"Check '{name}' not found in results.")


# ── Fixtures ─────────────────────────────────────────────────────────────────

@pytest.fixture
def base_src():
    return pd.DataFrame({
        "id":         [1, 2, 3],
        "name":       ["Alice", "Bob", "Carol"],
        "score":      [9.5, 8.0, 7.2],
        "active":     [True, False, True],
        "created_at": pd.to_datetime(["2024-01-01", "2024-01-02", "2024-01-03"]),
    })


@pytest.fixture
def base_tgt(base_src):
    """Identical copy of src — all checks should pass."""
    return base_src.copy()


@pytest.fixture
def cfg():
    return make_config()


# ══════════════════════════════════════════════════════════════════════════════
# 1. column_count
# ══════════════════════════════════════════════════════════════════════════════

class TestColumnCount:

    def test_equal_column_counts_passes(self, base_src, base_tgt, cfg):
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "column_count")
        assert c.status == Status.PASSED
        assert c.details["source_count"] == c.details["target_count"]

    def test_extra_target_column_fails(self, base_src, base_tgt, cfg):
        base_tgt["extra"] = 0
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "column_count")
        assert c.status == Status.FAILED
        assert c.details["source_count"] == 5
        assert c.details["target_count"] == 6

    def test_missing_target_column_fails(self, base_src, base_tgt, cfg):
        base_tgt = base_tgt.drop(columns=["score"])
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "column_count")
        assert c.status == Status.FAILED

    def test_empty_dataframes_pass(self, cfg):
        src = pd.DataFrame()
        tgt = pd.DataFrame()
        result = layer.run(src, tgt, cfg)
        c = check(result, "column_count")
        assert c.status == Status.PASSED


# ══════════════════════════════════════════════════════════════════════════════
# 2. column_names
# ══════════════════════════════════════════════════════════════════════════════

class TestColumnNames:

    def test_identical_columns_passes(self, base_src, base_tgt, cfg):
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "column_names")
        assert c.status == Status.PASSED
        assert c.details["missing_in_target"] == []
        assert c.details["extra_in_target"] == []

    def test_renamed_column_fails(self, base_src, base_tgt, cfg):
        base_tgt = base_tgt.rename(columns={"score": "points"})
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "column_names")
        assert c.status == Status.FAILED
        assert "score" in c.details["missing_in_target"]
        assert "points" in c.details["extra_in_target"]

    def test_missing_column_in_target_reported(self, base_src, cfg):
        tgt = base_src.drop(columns=["name"]).copy()
        tgt["bonus"] = 0
        result = layer.run(base_src, tgt, cfg)
        c = check(result, "column_names")
        assert "name" in c.details["missing_in_target"]
        assert "bonus" in c.details["extra_in_target"]

    def test_case_sensitive_mismatch(self, base_src, base_tgt, cfg):
        base_tgt = base_tgt.rename(columns={"id": "ID"})
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "column_names")
        assert c.status == Status.FAILED


# ══════════════════════════════════════════════════════════════════════════════
# 3. data_types
# ══════════════════════════════════════════════════════════════════════════════

class TestDataTypes:

    def test_identical_dtypes_passes(self, base_src, base_tgt, cfg):
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "data_types")
        assert c.status == Status.PASSED
        assert c.details["mismatches"] == {}

    def test_int_vs_float_fails(self, base_src, base_tgt, cfg):
        # 'id' is integer in src; cast to float in tgt → family mismatch
        base_tgt["id"] = base_tgt["id"].astype(float)
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "data_types")
        assert c.status == Status.FAILED
        assert "id" in c.details["mismatches"]

    def test_string_vs_int_fails(self, base_src, base_tgt, cfg):
        base_tgt["id"] = base_tgt["id"].astype(str)
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "data_types")
        assert c.status == Status.FAILED
        assert "id" in c.details["mismatches"]

    def test_same_family_different_width_passes(self, base_src, base_tgt, cfg):
        # int32 vs int64 are the same family → should PASS
        base_src["id"] = base_src["id"].astype("int32")
        base_tgt["id"] = base_tgt["id"].astype("int64")
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "data_types")
        assert c.status == Status.PASSED

    def test_multiple_dtype_mismatches(self, base_src, base_tgt, cfg):
        base_tgt["id"]    = base_tgt["id"].astype(float)
        base_tgt["score"] = base_tgt["score"].astype(str)
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "data_types")
        assert c.status == Status.FAILED
        assert len(c.details["mismatches"]) == 2

    def test_datetime_vs_object_fails(self, base_src, base_tgt, cfg):
        base_tgt["created_at"] = base_tgt["created_at"].astype(str)
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "data_types")
        assert "created_at" in c.details["mismatches"]


# ══════════════════════════════════════════════════════════════════════════════
# 4. null_counts
# ══════════════════════════════════════════════════════════════════════════════

class TestNullCounts:

    def test_no_nulls_passes(self, base_src, base_tgt, cfg):
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "null_counts")
        assert c.status == Status.PASSED

    def test_equal_nulls_passes(self, base_src, cfg):
        base_src.loc[0, "name"] = None
        tgt = base_src.copy()
        result = layer.run(base_src, tgt, cfg)
        c = check(result, "null_counts")
        assert c.status == Status.PASSED

    def test_null_count_mismatch_fails(self, base_src, base_tgt, cfg):
        base_tgt.loc[0, "score"] = None
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "null_counts")
        assert c.status == Status.FAILED
        assert "score" in c.details["null_issues"]
        assert c.details["null_issues"]["score"]["source_nulls"] == 0
        assert c.details["null_issues"]["score"]["target_nulls"] == 1

    def test_multiple_null_mismatches_reported(self, base_src, base_tgt, cfg):
        base_tgt.loc[0, "name"]  = None
        base_tgt.loc[1, "score"] = None
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "null_counts")
        assert c.status == Status.FAILED
        assert len(c.details["null_issues"]) == 2

    def test_src_has_more_nulls_than_tgt_fails(self, base_src, base_tgt, cfg):
        base_src.loc[0, "name"] = None
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "null_counts")
        assert c.status == Status.FAILED


# ══════════════════════════════════════════════════════════════════════════════
# 5. column_order
# ══════════════════════════════════════════════════════════════════════════════

class TestColumnOrder:

    def test_order_check_disabled_by_default(self, base_src, base_tgt, cfg):
        # Shuffle target columns — should not matter when flag is off
        base_tgt = base_tgt[reversed(base_tgt.columns)]
        result = layer.run(base_src, base_tgt, cfg)
        check_names = [c.check_name for c in result.checks]
        assert "column_order" not in check_names

    def test_same_order_passes_when_enabled(self, base_src, base_tgt):
        cfg = make_config(check_column_order=True)
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "column_order")
        assert c.status == Status.PASSED

    def test_different_order_fails_when_enabled(self, base_src, base_tgt):
        cfg = make_config(check_column_order=True)
        cols = list(base_tgt.columns)
        base_tgt = base_tgt[cols[::-1]]
        result = layer.run(base_src, base_tgt, cfg)
        c = check(result, "column_order")
        assert c.status == Status.FAILED
        assert c.details["source_order"] != c.details["target_order"]


# ══════════════════════════════════════════════════════════════════════════════
# 6. Early-exit on column-name failure
# ══════════════════════════════════════════════════════════════════════════════

class TestEarlyExit:

    def test_stops_after_column_name_failure(self, base_src, cfg):
        """When column names differ, dtype and null checks must not be added."""
        tgt = base_src.rename(columns={"id": "identifier"})
        result = layer.run(base_src, tgt, cfg)

        check_names = [c.check_name for c in result.checks]
        assert "column_names" in check_names
        assert "data_types"   not in check_names
        assert "null_counts"  not in check_names

    def test_overall_layer_status_failed_on_any_failure(self, base_src, base_tgt, cfg):
        base_tgt.loc[0, "score"] = None  # null mismatch only
        result = layer.run(base_src, base_tgt, cfg)
        assert result.status == Status.FAILED

    def test_overall_layer_status_passed_when_all_pass(self, base_src, base_tgt, cfg):
        result = layer.run(base_src, base_tgt, cfg)
        assert result.status == Status.PASSED


# ══════════════════════════════════════════════════════════════════════════════
# 7. _dtype_family (unit tests for the private helper)
# ══════════════════════════════════════════════════════════════════════════════

class TestDtypeFamily:

    @pytest.mark.parametrize("dtype, expected", [
        ("int32",           "integer"),
        ("int64",           "integer"),
        ("uint8",           "integer"),
        ("float32",         "float"),
        ("float64",         "float"),
        ("object",          "string"),
        ("bool",            "boolean"),
        ("datetime64[ns]",  "datetime"),
        ("timedelta64[ns]", "timedelta"),
    ])
    def test_known_families(self, dtype, expected):
        series = pd.Series([], dtype=dtype)
        assert layer._dtype_family(series.dtype) == expected

    def test_unknown_dtype_returns_dtype_string(self):
        """Unrecognised kinds fall back to str(dtype)."""
        # complex128 has kind 'c' — not in the map
        series = pd.Series([], dtype="complex128")
        result = layer._dtype_family(series.dtype)
        assert result == "complex128"





