      "tables": [
        {{
          "table_name": "source_customers",
          "model_data": [
            {{ "column": "id",   "type": "SERIAL", "constraint": "PRIMARY KEY" }},
            {{ "column": "name", "type": "TEXT",   "constraint": "NOT NULL"    }}
          ],
          "input_data":      [{{ "id": 1, "name": "Alice" }}],
          "expected_output": [{{ "id": 1, "name": "Alice" }}]
        }},
        {{
          "table_name": "target_customers",
          "model_data": [
            {{ "column": "source_id",    "type": "INT",  "constraint": "NOT NULL" }},
            {{ "column": "display_name", "type": "TEXT", "constraint": "NOT NULL" }}
          ],
          "input_data":      [{{ "source_id": 1, "display_name": "ALICE" }}],
          "expected_output": [{{ "source_id": 1, "display_name": "ALICE" }}]
        }}
      ]
    }}
    """.strip()

    def _parse_response(self, content: str) -> dict:
        """
        Extracts valid JSON from the LLM response, ignoring extra text or Markdown fences.
        """
        if isinstance(content, dict):
            return content

        if hasattr(content, "model_dump"):
            return content.model_dump()

        content = str(content).strip()

        # Remove Markdown fences
        if content.startswith("```"):
            lines = content.splitlines()
            content = "\n".join(
                line for line in lines if not line.strip().startswith("```")
            ).strip()

        # Keep only the first {...} block to avoid extra trailing text
        first_brace = content.find("{")
