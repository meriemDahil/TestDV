# 6. row_aligned_diff
# ══════════════════════════════════════════════════════════════════════════════

class TestRowAlignedDiff:

    def test_no_pk_skips_check(self, base_df, cfg):
        result = layer.run(base_df, base_df.copy(), cfg)
        c = check(result, "row_aligned_diff")
        assert c.status == Status.SKIPPED
        assert c.skipped_reason is not None
        assert "primary_key" in c.skipped_reason

    def test_missing_pk_column_fails(self, base_df):
        cfg = make_config(primary_key=["nonexistent_col"])
        result = layer.run(base_df, base_df.copy(), cfg)
        c = check(result, "row_aligned_diff")
        assert c.status == Status.FAILED
        assert "nonexistent_col" in c.details["missing_pk_cols"]

    def test_no_differences_passes(self, base_df, cfg_with_pk):
        result = layer.run(base_df, base_df.copy(), cfg_with_pk)
        c = check(result, "row_aligned_diff")
        assert c.status == Status.PASSED
        assert c.details["diff_sample"] == []

    def test_detects_value_change(self, base_df, cfg_with_pk):
        tgt = base_df.copy()
        tgt.loc[tgt["id"] == 2, "score"] = 99.9
        result = layer.run(base_df, tgt, cfg_with_pk)
        c = check(result, "row_aligned_diff")
        assert c.status == Status.FAILED
        assert len(c.details["diff_sample"]) == 1
        diff_row = c.details["diff_sample"][0]
        assert diff_row["id"] == 2

    def test_detects_multiple_changed_rows(self, base_df, cfg_with_pk):
        tgt = base_df.copy()
        tgt.loc[0, "name"] = "CHANGED"
        tgt.loc[2, "name"] = "CHANGED"
        result = layer.run(base_df, tgt, cfg_with_pk)
        c = check(result, "row_aligned_diff")
        assert c.status == Status.FAILED
        assert len(c.details["diff_sample"]) == 2

    def test_diff_capped_at_limit(self):
        # 25 rows, all names changed — diff output must cap at 20
        src = pd.DataFrame({
            "id":    list(range(25)),
            "name":  [f"Name_{i}" for i in range(25)],
            "score": [float(i) for i in range(25)],
        })
        tgt = src.copy()
        tgt["name"] = "CHANGED"
        cfg = make_config(primary_key=["id"])
        result = layer.run(src, tgt, cfg)
        c = check(result, "row_aligned_diff")
        assert len(c.details["diff_sample"]) == 20

    def test_compound_primary_key(self):
        src = pd.DataFrame({
            "year":  [2023, 2023, 2024],
            "month": [1,    2,    1   ],
            "value": [10,   20,   30  ],
        })
        tgt = src.copy()
        tgt.loc[0, "value"] = 99
        cfg = make_config(primary_key=["year", "month"])
        result = layer.run(src, tgt, cfg)
        c = check(result, "row_aligned_diff")
        assert c.status == Status.FAILED
        assert len(c.details["diff_sample"]) == 1


# ══════════════════════════════════════════════════════════════════════════════
# 7. _dataset_hash  (helper)
# ══════════════════════════════════════════════════════════════════════════════

class TestDatasetHash:

    def test_same_data_same_hash(self, base_df):
        h1 = layer._dataset_hash(base_df, list(base_df.columns))
        h2 = layer._dataset_hash(base_df.copy(), list(base_df.columns))
        assert h1 == h2

    def test_changed_value_changes_hash(self, base_df):
        tgt = base_df.copy()
        tgt.loc[0, "score"] = 0.0
        h1 = layer._dataset_hash(base_df, list(base_df.columns))
        h2 = layer._dataset_hash(tgt, list(base_df.columns))
        assert h1 != h2

    def test_row_order_independent(self, base_df):
        shuffled = base_df.iloc[::-1].reset_index(drop=True)
        h1 = layer._dataset_hash(base_df, list(base_df.columns))
        h2 = layer._dataset_hash(shuffled, list(base_df.columns))
        assert h1 == h2

    def test_null_values_handled(self):
        df1 = pd.DataFrame({"a": [1, None], "b": ["x", "y"]})
        df2 = pd.DataFrame({"a": [1, None], "b": ["x", "y"]})
        h1 = layer._dataset_hash(df1, ["a", "b"])
        h2 = layer._dataset_hash(df2, ["a", "b"])
        assert h1 == h2

    def test_null_vs_non_null_differs(self):
        df1 = pd.DataFrame({"a": [1, None]})
        df2 = pd.DataFrame({"a": [1, 2]})
        assert layer._dataset_hash(df1, ["a"]) != layer._dataset_hash(df2, ["a"])

    def test_returns_64_char_hex(self, base_df):
        h = layer._dataset_hash(base_df, list(base_df.columns))
        assert len(h) == 64
        assert all(c in "0123456789abcdef" for c in h)

    def test_col_subset_used(self, base_df):
        # hashing only ["id"] should differ from hashing all columns
        h_all = layer._dataset_hash(base_df, list(base_df.columns))
        h_sub = layer._dataset_hash(base_df, ["id"])
        assert h_all != h_sub


# ══════════════════════════════════════════════════════════════════════════════
# 8. _column_hash  (helper)
# ══════════════════════════════════════════════════════════════════════════════

class TestColumnHash:

    def test_same_series_same_hash(self):
        s = pd.Series([1, 2, 3])
        assert layer._column_hash(s) == layer._column_hash(s.copy())

    def test_different_values_different_hash(self):
        s1 = pd.Series([1, 2, 3])
        s2 = pd.Series([1, 2, 99])
        assert layer._column_hash(s1) != layer._column_hash(s2)

    def test_order_independent(self):
        s1 = pd.Series([3, 1, 2])
        s2 = pd.Series([1, 2, 3])
        assert layer._column_hash(s1) == layer._column_hash(s2)

    def test_null_values_handled(self):
        s1 = pd.Series([1, None, 3])
        s2 = pd.Series([1, None, 3])
        assert layer._column_hash(s1) == layer._column_hash(s2)

    def test_null_vs_value_differs(self):
        s1 = pd.Series([1, None])
        s2 = pd.Series([1, 0])
        assert layer._column_hash(s1) != layer._column_hash(s2)

    def test_returns_64_char_hex(self):
        h = layer._column_hash(pd.Series(["a", "b", "c"]))
        assert len(h) == 64


# ══════════════════════════════════════════════════════════════════════════════
# 9. _bucketed_checksum  (helper)
# ══════════════════════════════════════════════════════════════════════════════

class TestBucketedChecksumHelper:

    def test_identical_returns_empty(self, base_df):
        cols = list(base_df.columns)
        issues = layer._bucketed_checksum(base_df, base_df.copy(), cols, bucket_count=5)
        assert issues == []

    def test_changed_value_returns_mismatch(self, base_df):
        tgt = base_df.copy()
        tgt.loc[0, "score"] = 999.0
        cols = list(base_df.columns)
        issues = layer._bucketed_checksum(base_df, tgt, cols, bucket_count=5)
        assert len(issues) >= 1

    def test_mismatch_entry_has_expected_keys(self, base_df):
        tgt = base_df.copy()
        tgt.loc[0, "name"] = "CHANGED"
        cols = list(base_df.columns)
        issues = layer._bucketed_checksum(base_df, tgt, cols, bucket_count=5)
        for issue in issues:
            for key in ("bucket", "source_hash", "target_hash", "source_rows", "target_rows"):
                assert key in issue

    def test_bucket_count_one(self, base_df):
        tgt = base_df.copy()
        tgt.loc[0, "score"] = 0.0
        cols = list(base_df.columns)
        issues = layer._bucketed_checksum(base_df, tgt, cols, bucket_count=1)
        assert len(issues) == 1
        assert issues[0]["bucket"] == 0

    def test_reordered_rows_no_mismatch(self, base_df):
        tgt = base_df.iloc[::-1].reset_index(drop=True)
        cols = list(base_df.columns)
        issues = layer._bucketed_checksum(base_df, tgt, cols, bucket_count=5)
        assert issues == []


# ══════════════════════════════════════════════════════════════════════════════
# 10. _row_aligned_diff  (helper)
# ══════════════════════════════════════════════════════════════════════════════

class TestRowAlignedDiffHelper:

    def test_no_diff_returns_empty(self, base_df):
        diff = layer._row_aligned_diff(
            base_df, base_df.copy(), list(base_df.columns), ["id"]
        )
        assert diff.empty

    def test_detects_single_changed_cell(self, base_df):
        tgt = base_df.copy()
        tgt.loc[tgt["id"] == 3, "name"] = "CHANGED"
        diff = layer._row_aligned_diff(
            base_df, tgt, list(base_df.columns), ["id"]
        )
        assert len(diff) == 1
        assert diff.iloc[0]["id"] == 3

    def test_suffixes_applied(self, base_df):
        tgt = base_df.copy()
        tgt.loc[0, "score"] = 0.0
        diff = layer._row_aligned_diff(
            base_df, tgt, list(base_df.columns), ["id"]
        )
        assert "score_src" in diff.columns
        assert "score_tgt" in diff.columns

    def test_limit_caps_output(self):
        src = pd.DataFrame({
            "id":    list(range(30)),
            "value": [float(i) for i in range(30)],
        })
        tgt = src.copy()
        tgt["value"] = 0.0
        diff = layer._row_aligned_diff(src, tgt, ["id", "value"], ["id"], limit=10)
        assert len(diff) == 10

    def test_pk_only_rows_excluded_from_diff_mask(self):
        # If only PK cols exist, non_pk list is empty → diff_mask stays False → empty result
        src = pd.DataFrame({"id": [1, 2, 3]})
        tgt = pd.DataFrame({"id": [1, 2, 3]})
        diff = layer._row_aligned_diff(src, tgt, ["id"], ["id"])
        assert diff.empty

    def test_compound_pk(self):
        src = pd.DataFrame({
            "year":  [2023, 2024],
            "month": [1, 1],
            "val":   [10, 20],
        })
        tgt = src.copy()
        tgt.loc[0, "val"] = 99
        diff = layer._row_aligned_diff(
            src, tgt, ["year", "month", "val"], ["year", "month"]
        )
        assert len(diff) == 1
        assert diff.iloc[0]["year"] == 2023

    def test_unmatched_pk_rows_excluded(self):
        src = pd.DataFrame({"id": [1, 2, 3], "val": [10, 20, 30]})
        tgt = pd.DataFrame({"id": [1, 2, 9], "val": [10, 20, 99]})  # id=9 not in src
        diff = layer._row_aligned_diff(src, tgt, ["id", "val"], ["id"])
        # id=3 and id=9 are unmatched; inner join excludes them → only matched rows checked
        matched_ids = diff["id"].tolist()
        assert 3 not in matched_ids
        assert 9 not in matched_ids













#!/usr/bin/env python3
import json
from pathlib import Path
from typing import Any, Dict, List, Optional
import json
from agents import AgentOutputSchema
from openai import APITimeoutError
from pydantic import BaseModel, Field
from migration_factory_backend.services.general_agent import GeneralAgent
from migration_factory_backend.config.test_bench_agent_conf import (
    AGENT_NAME,
    INSTRUCTIONS,
    DEFAULT_ROWS
)
from migration_factory_backend.modules.test_bench.test_bench_agent_IO_model import ColumnSchema, TableResult, \
    TestBenchAgentIO, TestBenchAgentInputModel, TestBenchAgentOutputModel
import asyncio

from src.migration_factory_backend.utils.logger import initLogger


class TestBenchAgent(GeneralAgent):
    logger = initLogger("TestBenchAgent")

    def __init__(self) -> None:
        super().__init__(
            agent_name=AGENT_NAME,
            instructions=INSTRUCTIONS,
            io_model=AgentOutputSchema(TestBenchAgentOutputModel, strict_json_schema=False)
        )

        self.agent.tools = []

        self.agent_io = TestBenchAgentIO(
            input=TestBenchAgentInputModel(specification_content="")
        )

    def build_prompt(self, json_data: dict, num_rows: int = DEFAULT_ROWS, used_tables: list[str] = None) -> str:
        json_spec = json.dumps(json_data, indent=2, ensure_ascii=False)

        tables_instruction = ""
        if used_tables:
            tables_list = "\n".join(f"  - {t}" for t in used_tables)
            tables_instruction = f"""
    MANDATORY TABLES — You MUST generate data for ALL of these tables, no exception:
    {tables_list}
    If you already generated a table don't generate it again.
    """

        return f"""
    INPUT SPECIFICATION (JSON):
    {json_spec}

    TARGET ENVIRONMENT: POSTGRESQL
    - DATES: Use 'YYYY-MM-DD'
    - TIMESTAMPS: Use 'YYYY-MM-DD HH:MM:SS'
    - BOOLEANS: Use lowercase 'true' or 'false'
    - NUMERIC: Use dot as decimal separator

    ========================
    TASK REQUIREMENTS
    ========================
    {tables_instruction}
    1. Generate data for EVERY table listed above in MANDATORY TABLES.
    2. Keep table names EXACTLY as provided.
    3. Generate EXACTLY {num_rows} rows per table.
    4. For each table, return: table_name, model_data (NEVER empty), input_data, expected_output.
    5. expected_output MUST be IDENTICAL to input_data — a direct copy, no transformations.
    6. model_data must always contain valid column definitions.

    ========================
    OUTPUT FORMAT (STRICT JSON ONLY)
    ========================
    {{
    "tables": [
        {{
        "table_name": "my_table",
        "model_data": [
            {{ "column": "id", "type": "SERIAL", "constraint": "PRIMARY KEY" }},
            {{ "column": "signup_date", "type": "DATE", "constraint": "NOT NULL" }}
        ],
        "input_data": [
            {{ "id": 1, "signup_date": "2023-04-15" }}
        ],
        "expected_output": [
            {{ "id": 1, "signup_date": "2023-04-15" }}
        ]
        }}
    ]
    }}
    """.strip()

    def _parse_response(self, content: str) -> dict:
        """
        Extracts valid JSON from the LLM response, ignoring extra text or Markdown fences.
        """
        if isinstance(content, dict):
            return content

        if hasattr(content, "model_dump"):
            return content.model_dump()

        content = str(content).strip()

        # Remove Markdown fences
        if content.startswith("```"):
            lines = content.splitlines()
            content = "\n".join(line for line in lines if not line.strip().startswith("```")).strip()

        # Keep only the first {...} block to avoid extra text
        first_brace = content.find("{")
        last_brace = content.rfind("}")
        if first_brace == -1 or last_brace == -1:
            raise ValueError(f"Cannot find JSON in agent output:\n{content}")

        content = content[first_brace: last_brace + 1]

        try:
            return json.loads(content)
        except json.JSONDecodeError as e:
            raise ValueError(f"Invalid JSON returned by agent: {str(e)}\nContent:\n{content}")

    async def run(self, json_input: dict, num_rows: int = DEFAULT_ROWS, used_tables: list[str] = None) -> TestBenchAgentOutputModel:
        if not used_tables:
            self.logger.warning("[TestBenchAgent] No tables provided in used_tables; returning empty output.")
            self.agent_io.output = TestBenchAgentOutputModel(tables=[])
            return self.agent_io.output

        # Send ALL tables in a single prompt so the agent can keep foreign keys
        # and shared values consistent across tables.
        prompt = self.build_prompt(json_input, num_rows, used_tables=used_tables)

        self.agent_io.input = TestBenchAgentInputModel(
            specification_content=json.dumps(json_input, ensure_ascii=False)
        )

        max_retries = 3
        last_error = None

        for attempt in range(max_retries):
            try:
                raw_output = await self.runAgent(prompt)
                parsed = self._parse_response(raw_output)

                tables_payload = parsed.get("tables", [])
                if not isinstance(tables_payload, list):
                    raise ValueError("Le champ 'tables' doit être une liste.")

                all_tables: List[TableResult] = []
                for table_item in tables_payload:
                    if not isinstance(table_item, dict):
                        raise ValueError("Chaque table doit être un objet JSON.")

                    model_data_raw = table_item.get("model_data", [])
                    if not model_data_raw:
                        raise ValueError(f"model_data vide pour la table {table_item.get('table_name', 'unknown')}")

                    model_data = [ColumnSchema(**col) for col in model_data_raw]
                    all_tables.append(
                        TableResult(
                            table_name=table_item["table_name"],
                            model_data=model_data,
                            input_data=table_item.get("input_data", []),
                            expected_output=table_item.get("expected_output", []),
                            error=table_item.get("error", ""),
                        )
                    )

                self.agent_io.output = TestBenchAgentOutputModel(tables=all_tables)
                return self.agent_io.output

            except APITimeoutError as e:
                last_error = e
                wait = 5 * (attempt + 1)
                self.logger.warning(
                    f"[TestBenchAgent] Timeout on attempt {attempt + 1}/{max_retries}, "
                    f"retrying in {wait}s..."
                )
                await asyncio.sleep(wait)

            except Exception as e:
                raise RuntimeError(f"Erreur TestBenchAgent: {str(e)}")

        raise RuntimeError(
            f"Erreur TestBenchAgent: timed out after {max_retries} attempts. "
            f"Last error: {str(last_error)}"
        )







