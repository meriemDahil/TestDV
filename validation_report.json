# 6. CSVReader
# ══════════════════════════════════════════════════════════════════════════════

class TestCSVReaderEncoding:

    def test_detect_encoding_returns_string(self, tmp_path):
        f = tmp_path / "sample.csv"
        f.write_text("id,name\n1,Alice\n", encoding="utf-8")
        reader = CSVReader(str(f))
        enc = reader.detect_encoding()
        assert isinstance(enc, str)
        assert len(enc) > 0

    def test_detect_encoding_utf8_file(self, tmp_path):
        f = tmp_path / "utf8.csv"
        f.write_text("id,name\n1,Alice\n", encoding="utf-8")
        reader = CSVReader(str(f))
        enc = reader.detect_encoding()
        assert enc.lower().replace("-", "") in ("utf8", "ascii")

    def test_detect_encoding_fallback_when_chardet_returns_none(self, tmp_path):
        f = tmp_path / "empty.csv"
        f.write_bytes(b"")
        with patch("normalizers.chardet.detect", return_value={"encoding": None}):
            reader = CSVReader(str(f))
            enc = reader.detect_encoding()
        assert enc == "utf-8"


class TestCSVReaderSeparator:

    def test_detects_comma(self, tmp_path):
        f = tmp_path / "comma.csv"
        f.write_text("a,b,c\n1,2,3\n", encoding="utf-8")
        reader = CSVReader(str(f))
        assert reader.detect_separator("utf-8") == ","

    def test_detects_semicolon(self, tmp_path):
        f = tmp_path / "semi.csv"
        f.write_text("a;b;c\n1;2;3\n", encoding="utf-8")
        reader = CSVReader(str(f))
        assert reader.detect_separator("utf-8") == ";"

    def test_detects_tab(self, tmp_path):
        f = tmp_path / "tab.csv"
        f.write_text("a\tb\tc\n1\t2\t3\n", encoding="utf-8")
        reader = CSVReader(str(f))
        assert reader.detect_separator("utf-8") == "\t"

    def test_detects_pipe(self, tmp_path):
        f = tmp_path / "pipe.csv"
        f.write_text("a|b|c\n1|2|3\n", encoding="utf-8")
        reader = CSVReader(str(f))
        assert reader.detect_separator("utf-8") == "|"


class TestCSVReaderRead:

    def test_read_returns_dataframe(self, tmp_path):
        f = tmp_path / "data.csv"
        f.write_text("id,name\n1,Alice\n2,Bob\n", encoding="utf-8")
        reader = CSVReader(str(f))
        df = reader.read()
        assert isinstance(df, pd.DataFrame)
        assert list(df.columns) == ["id", "name"]
        assert len(df) == 2

    def test_read_semicolon_delimited(self, tmp_path):
        f = tmp_path / "semi.csv"
        f.write_text("id;name\n1;Alice\n2;Bob\n", encoding="utf-8")
        df = CSVReader(str(f)).read()
        assert "id" in df.columns
        assert "name" in df.columns

    def test_keep_default_na_false_preserves_empty_strings(self, tmp_path):
        # Without keep_default_na=False, pandas converts "" to NaN itself.
        # CSVReader disables this so NullNormalizer can handle it.
        f = tmp_path / "nulls.csv"
        f.write_text("id,name\n1,\n2,Bob\n", encoding="utf-8")
        df = CSVReader(str(f)).read()
        # raw read: empty cell should be "" not NaN
        assert df["name"].iloc[0] == ""


# ══════════════════════════════════════════════════════════════════════════════
# 7. load_csv()  — end-to-end
# ══════════════════════════════════════════════════════════════════════════════

class TestLoadCSV:

    def test_end_to_end_comma_delimited(self, tmp_path):
        f = tmp_path / "input.csv"
        f.write_text(
            "First Name ,Last-Name,Score\n"
            "  Alice  ,Dupont,9.5\n"
            "Bob  ,  null,8.0\n",
            encoding="utf-8",
        )
        df = load_csv(str(f))

        # columns normalized
        assert list(df.columns) == ["first_name", "last_name", "score"]

        # strings trimmed
        assert df["first_name"].iloc[0] == "Alice"
        assert df["last_name"].iloc[0]  == "Dupont"

        # null resolved
        assert df["last_name"].iloc[1] is None

    def test_end_to_end_semicolon_delimited(self, tmp_path):
        f = tmp_path / "euro.csv"
        f.write_text(
            "Prénom;Âge\nAlice;30\nBob;N/A\n",
            encoding="utf-8",
        )
        df = load_csv(str(f))
        assert "prenom" in df.columns
        assert "age"    in df.columns
        assert df["age"].iloc[1] is None

    def test_returns_dataframe(self, tmp_path):
        f = tmp_path / "basic.csv"
        f.write_text("a,b\n1,2\n", encoding="utf-8")
        result = load_csv(str(f))
        assert isinstance(result, pd.DataFrame)








