        output_tables: list[str] = None,
    ) -> TestBenchAgentOutputModel:
        """
        Parameters
        ----------
        json_input    : migration specification
        num_rows      : number of rows to generate per table
        input_tables  : source/raw table names (data going INTO the migration)
        output_tables : target table names    (data coming OUT of the migration)

        Both lists are sent together in a single prompt so the agent has full
        context about the data flow and can guarantee cross-table consistency.
        """
        input_tables  = input_tables  or []
        output_tables = output_tables or []
        all_tables    = list(dict.fromkeys(input_tables + output_tables))

        if not all_tables:
            self.logger.warning("[TestBenchAgent] No tables provided; returning empty output.")
            self.agent_io.output = TestBenchAgentOutputModel(tables=[])
