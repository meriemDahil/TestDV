"""
Unit tests for Layer 2 – Data Level Validation.

Coverage:
  1. row_count            – match / mismatch / early-exit
  2. full_dataset_hash    – identical / value changed / row reordered
  3. column_level_hash    – all match / single mismatch / multiple mismatches
  4. duplicate_rows       – equal dups / mismatch
  5. bucketed_checksum    – all match / bucket mismatch localised
  6. row_aligned_diff     – no pk (skipped) / missing pk col / clean / diffs / limit cap
  7. _dataset_hash        – order independence / null safety
  8. _column_hash         – sorted + null-safe
  9. _bucketed_checksum   – direct helper tests
 10. _row_aligned_diff    – direct helper tests
"""
from __future__ import annotations

from unittest.mock import MagicMock

import pandas as pd
import pytest

from core.models import Status, ValidationConfig
from layers import layer_2_data_level as layer


# ── Helpers ───────────────────────────────────────────────────────────────────

def make_config(
    primary_key=None,
    source_label: str = "source",
    target_label: str = "target",
) -> ValidationConfig:
    cfg = MagicMock(spec=ValidationConfig)
    cfg.primary_key = primary_key or []
    cfg.source_label = source_label
    cfg.target_label = target_label
    return cfg


def check(result, name: str):
    for c in result.checks:
        if c.check_name == name:
            return c
    raise KeyError(f"Check '{name}' not found.")


# ── Fixtures ──────────────────────────────────────────────────────────────────

@pytest.fixture
def base_df():
    return pd.DataFrame({
        "id":    [1, 2, 3, 4, 5],
        "name":  ["Alice", "Bob", "Carol", "Dave", "Eve"],
        "score": [9.5, 8.0, 7.2, 6.1, 5.5],
    })


@pytest.fixture
def cfg():
    return make_config()


@pytest.fixture
def cfg_with_pk():
    return make_config(primary_key=["id"])


# ══════════════════════════════════════════════════════════════════════════════
# 1. row_count
# ══════════════════════════════════════════════════════════════════════════════

class TestRowCount:

    def test_equal_row_counts_passes(self, base_df, cfg):
        result = layer.run(base_df, base_df.copy(), cfg)
        c = check(result, "row_count")
        assert c.status == Status.PASSED
        assert c.details["delta"] == 0

    def test_target_has_more_rows_fails(self, base_df, cfg):
        tgt = pd.concat([base_df, base_df.iloc[:2]], ignore_index=True)
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "row_count")
        assert c.status == Status.FAILED
        assert c.details["source_rows"] == 5
        assert c.details["target_rows"] == 7
        assert c.details["delta"] == -2

    def test_target_has_fewer_rows_fails(self, base_df, cfg):
        tgt = base_df.iloc[:3].copy()
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "row_count")
        assert c.status == Status.FAILED
        assert c.details["delta"] == 2

    def test_early_exit_on_row_count_failure(self, base_df, cfg):
        tgt = base_df.iloc[:2].copy()
        result = layer.run(base_df, tgt, cfg)
        check_names = [c.check_name for c in result.checks]
        assert "row_count" in check_names
        assert "full_dataset_hash" not in check_names
        assert "column_level_hash" not in check_names

    def test_empty_dataframes_pass(self, cfg):
        src = pd.DataFrame({"id": [], "name": []})
        tgt = pd.DataFrame({"id": [], "name": []})
        result = layer.run(src, tgt, cfg)
        c = check(result, "row_count")
        assert c.status == Status.PASSED

    def test_message_contains_delta(self, base_df, cfg):
        tgt = base_df.iloc[:3].copy()
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "row_count")
        assert "delta=2" in c.message


# ══════════════════════════════════════════════════════════════════════════════
# 2. full_dataset_hash
# ══════════════════════════════════════════════════════════════════════════════

class TestFullDatasetHash:

    def test_identical_datasets_pass(self, base_df, cfg):
        result = layer.run(base_df, base_df.copy(), cfg)
        c = check(result, "full_dataset_hash")
        assert c.status == Status.PASSED
        assert c.details["source_hash"] == c.details["target_hash"]

    def test_changed_value_fails(self, base_df, cfg):
        tgt = base_df.copy()
        tgt.loc[0, "score"] = 99.9
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "full_dataset_hash")
        assert c.status == Status.FAILED
        assert c.details["source_hash"] != c.details["target_hash"]

    def test_reordered_rows_still_pass(self, base_df, cfg):
        # _dataset_hash sorts rows before hashing — order should not matter
        tgt = base_df.iloc[::-1].reset_index(drop=True)
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "full_dataset_hash")
        assert c.status == Status.PASSED

    def test_added_null_value_fails(self, base_df, cfg):
        tgt = base_df.copy()
        tgt.loc[0, "name"] = None
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "full_dataset_hash")
        assert c.status == Status.FAILED

    def test_hash_is_hex_string(self, base_df, cfg):
        result = layer.run(base_df, base_df.copy(), cfg)
        c = check(result, "full_dataset_hash")
        assert len(c.details["source_hash"]) == 64   # SHA-256 hex


