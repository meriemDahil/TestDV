"""
Unit tests for normalizers.py

Coverage:
  ColumnNormalizer   – normalize() static / apply() / duplicate deduplication
  NullNormalizer     – all NULL_VALUES variants / non-null passthrough
  StringTrimNormalizer – string stripping / non-object columns untouched
  normalize()        – full chain integration
  CSVReader          – encoding detection / separator detection / read()
  load_csv()         – end-to-end smoke test via tmp file
"""
from __future__ import annotations

import os
import tempfile
from unittest.mock import MagicMock, mock_open, patch

import pandas as pd
import pytest

from normalizers import (
    CSVReader,
    ColumnNormalizer,
    NullNormalizer,
    StringTrimNormalizer,
    load_csv,
    normalize,
)


# ══════════════════════════════════════════════════════════════════════════════
# 1. ColumnNormalizer.normalize  (static method)
# ══════════════════════════════════════════════════════════════════════════════

class TestColumnNormalizerStaticMethod:

    @pytest.mark.parametrize("raw, expected", [
        ("First Name ",   "first_name"),       # trailing space + title case
        (" Last Name",    "last_name"),         # leading space
        ("Montant-HT",    "montant_ht"),        # hyphen → underscore
        ("UPPER_CASE",    "upper_case"),        # already underscored
        ("mixedCase",     "mixedcase"),         # camel → lower (no separator added)
        ("  spaces  ",    "spaces"),            # multiple surrounding spaces
        ("café",          "cafe"),              # accented char via unidecode
        ("naïve",         "naive"),             # accent removal
        ("col-name end ", "col_name_end"),      # hyphen + trailing space
        ("A",             "a"),                 # single char
        ("",              ""),                  # empty string
    ])
    def test_normalize_variants(self, raw, expected):
        assert ColumnNormalizer.normalize(raw) == expected

    def test_multiple_hyphens_and_spaces(self):
        assert ColumnNormalizer.normalize("first - last") == "first _ last"

    def test_returns_string(self):
        result = ColumnNormalizer.normalize("Col")
        assert isinstance(result, str)


# ══════════════════════════════════════════════════════════════════════════════
# 2. ColumnNormalizer.apply
# ══════════════════════════════════════════════════════════════════════════════

class TestColumnNormalizerApply:

    def test_basic_normalization(self):
        df = pd.DataFrame(columns=["First Name ", "Last-Name", "AGE"])
        result = ColumnNormalizer().apply(df)
        assert list(result.columns) == ["first_name", "last_name", "age"]

    def test_does_not_mutate_original(self):
        df = pd.DataFrame(columns=["First Name"])
        original_cols = list(df.columns)
        ColumnNormalizer().apply(df)
        assert list(df.columns) == original_cols

    def test_data_preserved(self):
        df = pd.DataFrame({"First Name ": ["Alice", "Bob"]})
        result = ColumnNormalizer().apply(df)
        assert list(result["first_name"]) == ["Alice", "Bob"]

    def test_duplicate_after_normalization_deduped(self):
        # "Name " and "Name" both → "name" after normalization
        df = pd.DataFrame(columns=["Name ", "Name"])
        result = ColumnNormalizer().apply(df)
        assert list(result.columns) == ["name", "name_1"]

    def test_triple_duplicate_deduped(self):
        df = pd.DataFrame(columns=["col", "col", "col"])
        result = ColumnNormalizer().apply(df)
        assert list(result.columns) == ["col", "col_1", "col_2"]

    def test_no_false_dedup_for_unique_names(self):
        df = pd.DataFrame(columns=["alpha", "beta", "gamma"])
        result = ColumnNormalizer().apply(df)
        assert list(result.columns) == ["alpha", "beta", "gamma"]

    def test_empty_dataframe(self):
        df = pd.DataFrame()
        result = ColumnNormalizer().apply(df)
        assert list(result.columns) == []

    def test_accented_column_names(self):
        df = pd.DataFrame(columns=["Prénom", "Âge"])
        result = ColumnNormalizer().apply(df)
        assert list(result.columns) == ["prenom", "age"]


# ══════════════════════════════════════════════════════════════════════════════
# 3. NullNormalizer
# ══════════════════════════════════════════════════════════════════════════════

class TestNullNormalizer:

    @pytest.mark.parametrize("value", [
        "", " ", "null", "Null", "NULL",
        "none", "None", "NONE",
        "na", "NA", "n/a", "N/A",
        "?", "nan", "NaN", "NAN",
        "nil", "n.a.", "nd", "#n/a", "#N/A",
    ])
    def test_null_like_strings_become_none(self, value):
        df = pd.DataFrame({"col": [value]})
        result = NullNormalizer().apply(df)
        assert result["col"].iloc[0] is None

    def test_actual_none_remains_none(self):
        df = pd.DataFrame({"col": [None]})
        result = NullNormalizer().apply(df)
        assert result["col"].iloc[0] is None

    def test_real_values_untouched(self):
        df = pd.DataFrame({"col": ["Alice", "Bob", "0", "false"]})
        result = NullNormalizer().apply(df)
        assert list(result["col"]) == ["Alice", "Bob", "0", "false"]

    def test_numeric_values_untouched(self):
        df = pd.DataFrame({"num": [1, 2, 3]})
        result = NullNormalizer().apply(df)
        assert list(result["num"]) == [1, 2, 3]

    def test_mixed_column(self):
        df = pd.DataFrame({"col": ["Alice", "null", "Bob", "n/a", "Carol"]})
        result = NullNormalizer().apply(df)
        assert result["col"].iloc[0] == "Alice"
        assert result["col"].iloc[1] is None
        assert result["col"].iloc[2] == "Bob"
        assert result["col"].iloc[3] is None
        assert result["col"].iloc[4] == "Carol"

    def test_whitespace_around_null_keyword(self):
        # "  null  " → strip → "null" → None
        df = pd.DataFrame({"col": ["  null  "]})
        result = NullNormalizer().apply(df)
        assert result["col"].iloc[0] is None

    def test_empty_dataframe(self):
        df = pd.DataFrame({"col": pd.Series([], dtype=object)})
        result = NullNormalizer().apply(df)
        assert len(result) == 0


# ══════════════════════════════════════════════════════════════════════════════
# 4. StringTrimNormalizer
# ══════════════════════════════════════════════════════════════════════════════

class TestStringTrimNormalizer:

    def test_strips_leading_and_trailing_spaces(self):
        df = pd.DataFrame({"name": ["  Alice  ", "Bob ", " Carol"]})
        result = StringTrimNormalizer().apply(df)
        assert list(result["name"]) == ["Alice", "Bob", "Carol"]

    def test_non_object_columns_untouched(self):
        df = pd.DataFrame({"score": [1.1, 2.2, 3.3]})
        result = StringTrimNormalizer().apply(df)
        assert list(result["score"]) == [1.1, 2.2, 3.3]

    def test_does_not_mutate_original(self):
        df = pd.DataFrame({"name": ["  Alice  "]})
        StringTrimNormalizer().apply(df)
        assert df["name"].iloc[0] == "  Alice  "

    def test_none_in_string_column_survives(self):
        df = pd.DataFrame({"name": ["Alice", None, " Bob "]})
        result = StringTrimNormalizer().apply(df)
        assert result["name"].iloc[0] == "Alice"
        assert result["name"].iloc[1] is None
        assert result["name"].iloc[2] == "Bob"

    def test_mixed_dtypes(self):
        df = pd.DataFrame({
            "name":  ["  Alice  ", " Bob"],
            "score": [9.5, 8.0],
            "flag":  [True, False],
        })
        result = StringTrimNormalizer().apply(df)
        assert list(result["name"])  == ["Alice", "Bob"]
        assert list(result["score"]) == [9.5, 8.0]
        assert list(result["flag"])  == [True, False]

    def test_empty_string_stays_empty(self):
        df = pd.DataFrame({"col": [""]})
        result = StringTrimNormalizer().apply(df)
        assert result["col"].iloc[0] == ""

    def test_inner_whitespace_preserved(self):
        df = pd.DataFrame({"col": ["  hello world  "]})
        result = StringTrimNormalizer().apply(df)
        assert result["col"].iloc[0] == "hello world"


# ══════════════════════════════════════════════════════════════════════════════
# 5. normalize()  — full chain
# ══════════════════════════════════════════════════════════════════════════════

class TestNormalizeChain:

    def test_full_chain_applied_in_order(self):
        df = pd.DataFrame({
            "First Name ": ["  Alice  ", "null"],
            "Last-Name":   [" Dupont",  "N/A"],
        })
        result = normalize(df)

        # columns normalized
        assert "first_name" in result.columns
        assert "last_name"  in result.columns

        # strings trimmed
        assert result["first_name"].iloc[0] == "Alice"
        assert result["last_name"].iloc[0]  == "Dupont"

        # null-like values resolved
        assert result["first_name"].iloc[1] is None
        assert result["last_name"].iloc[1]  is None

    def test_does_not_mutate_input(self):
        df = pd.DataFrame({"Col ": ["  val  "]})
        original_col = list(df.columns)[0]
        normalize(df)
        assert list(df.columns)[0] == original_col

    def test_deterministic_same_output_for_same_input(self):
        df = pd.DataFrame({"First Name ": ["  Alice  ", "null", "Bob"]})
        r1 = normalize(df)
        r2 = normalize(df)
        pd.testing.assert_frame_equal(r1, r2)

    def test_empty_dataframe(self):
        df = pd.DataFrame()
        result = normalize(df)
        assert result.empty


