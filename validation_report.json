        num_rows: int = DEFAULT_ROWS,
        used_tables: list[str] = None,
        input_tables: list[str] = None,
        output_tables: list[str] = None,
    ) -> str:
        """
        Build a single prompt covering all tables in one shot so the agent can
        keep foreign keys, shared business keys, and derived columns consistent.

        Call modes:
          - used_tables only            → no input/output distinction (legacy mode,
                                          all tables treated as passthrough)
          - input_tables + output_tables → full data-flow context; agent knows which
                                          tables are sources and which are targets
          - all three                   → input/output_tables take precedence;
                                          used_tables is ignored
        """
        json_spec = json.dumps(json_data, indent=2, ensure_ascii=False)

        # Resolve the final table sets
        if input_tables or output_tables:
            # Rich mode: caller explicitly separated sources from targets
            input_tables  = input_tables  or []
            output_tables = output_tables or []
        else:
            # Legacy mode: used_tables only — treat everything as passthrough
            input_tables  = used_tables or []
            output_tables = []

        all_tables = list(dict.fromkeys(input_tables + output_tables))

        input_list  = "\n".join(f"  - {t}" for t in input_tables)  or "  (none)"
        output_list = "\n".join(f"  - {t}" for t in output_tables) or "  (none)"
        all_list    = "\n".join(f"  - {t}" for t in all_tables)

        return f"""
    INPUT SPECIFICATION (JSON):
    {json_spec}

    TARGET ENVIRONMENT: POSTGRESQL
    - DATES: Use 'YYYY-MM-DD'
    - TIMESTAMPS: Use 'YYYY-MM-DD HH:MM:SS'
    - BOOLEANS: Use lowercase 'true' or 'false'
    - NUMERIC: Use dot as decimal separator

    ========================
    DATA FLOW
    ========================
    SOURCE / INPUT tables  (raw data that enters the migration):
    {input_list}

    TARGET / OUTPUT tables (transformed data produced by the migration):
    {output_list}

    ========================
    TASK REQUIREMENTS
    ========================
    Generate consistent test data for ALL of the following tables:
    {all_list}

    Rules:
    1. Generate EXACTLY {num_rows} rows per table.
    2. Keep table names EXACTLY as listed above.
    3. For SOURCE tables:
       - input_data      = the raw rows fed into the migration.
       - expected_output = IDENTICAL copy of input_data (no transformation on the source side).
    4. For TARGET tables:
       - input_data      = the rows the migration is expected to produce (derived from the source data above).
       - expected_output = IDENTICAL copy of that input_data.
    5. If a table appears in both SOURCE and TARGET, treat it as passthrough:
       expected_output = IDENTICAL copy of input_data.
    6. CRITICAL — cross-table consistency:
       - Foreign keys in any table MUST reference real primary-key values present in the related table.
       - Shared business keys (e.g. customer_id, order_id) MUST carry the same values across all tables.
       - Derived / computed columns in target tables MUST be correctly calculated from the source rows.
    7. model_data must always contain valid column definitions and must NEVER be empty.

    ========================
    OUTPUT FORMAT (STRICT JSON ONLY)
    ========================
    {{
      "tables": [
        {{
          "table_name": "source_customers",
          "model_data": [
            {{ "column": "id",   "type": "SERIAL", "constraint": "PRIMARY KEY" }},
            {{ "column": "name", "type": "TEXT",   "constraint": "NOT NULL"    }}
          ],
          "input_data":      [{{ "id": 1, "name": "Alice" }}],
          "expected_output": [{{ "id": 1, "name": "Alice" }}]
        }},
        {{
          "table_name": "target_customers",
          "model_data": [
            {{ "column": "source_id",    "type": "INT",  "constraint": "NOT NULL" }},
            {{ "column": "display_name", "type": "TEXT", "constraint": "NOT NULL" }}
          ],
          "input_data":      [{{ "source_id": 1, "display_name": "ALICE" }}],
          "expected_output": [{{ "source_id": 1, "display_name": "ALICE" }}]
        }}
      ]
    }}
    """.strip()

    def _parse_response(self, content: str) -> dict:
        """
        Extracts valid JSON from the LLM response, ignoring extra text or Markdown fences.
        """
        if isinstance(content, dict):
            return content

        if hasattr(content, "model_dump"):
            return content.model_dump()

        content = str(content).strip()

        # Remove Markdown fences
        if content.startswith("```"):
            lines = content.splitlines()
            content = "\n".join(
                line for line in lines if not line.strip().startswith("```")
            ).strip()

        # Keep only the first {...} block to avoid extra trailing text
        first_brace = content.find("{")
        last_brace  = content.rfind("}")
        if first_brace == -1 or last_brace == -1:
            raise ValueError(f"Cannot find JSON in agent output:\n{content}")

        content = content[first_brace: last_brace + 1]

        try:
            return json.loads(content)
        except json.JSONDecodeError as e:
            raise ValueError(
                f"Invalid JSON returned by agent: {str(e)}\nContent:\n{content}"
            )

    async def run(
        self,
        json_input: dict,
        num_rows: int = DEFAULT_ROWS,
        used_tables: list[str] = None,
        input_tables: list[str] = None,
        output_tables: list[str] = None,
    ) -> TestBenchAgentOutputModel:
        """
