# 3. column_level_hash
# ══════════════════════════════════════════════════════════════════════════════

class TestColumnLevelHash:

    def test_all_columns_match(self, base_df, cfg):
        result = layer.run(base_df, base_df.copy(), cfg)
        c = check(result, "column_level_hash")
        assert c.status == Status.PASSED
        assert c.details["mismatched_columns"] == []

    def test_single_column_mismatch(self, base_df, cfg):
        tgt = base_df.copy()
        tgt.loc[0, "score"] = 0.0
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "column_level_hash")
        assert c.status == Status.FAILED
        assert "score" in c.details["mismatched_columns"]
        assert "id"    not in c.details["mismatched_columns"]
        assert "name"  not in c.details["mismatched_columns"]

    def test_multiple_column_mismatches(self, base_df, cfg):
        tgt = base_df.copy()
        tgt.loc[0, "score"] = 0.0
        tgt.loc[1, "name"]  = "CHANGED"
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "column_level_hash")
        assert len(c.details["mismatched_columns"]) == 2

    def test_column_hash_details_present_for_all_columns(self, base_df, cfg):
        result = layer.run(base_df, base_df.copy(), cfg)
        c = check(result, "column_level_hash")
        for col in base_df.columns:
            assert col in c.details["column_hashes"]
            assert "source_hash" in c.details["column_hashes"][col]
            assert "target_hash" in c.details["column_hashes"][col]

    def test_column_reorder_does_not_cause_mismatch(self, base_df, cfg):
        tgt = base_df[["score", "name", "id"]].copy()  # different column order
        result = layer.run(base_df, tgt, cfg)
        c = check(result, "column_level_hash")
        assert c.status == Status.PASSED


# ══════════════════════════════════════════════════════════════════════════════
# 4. duplicate_rows
# ══════════════════════════════════════════════════════════════════════════════

class TestDuplicateRows:

    def test_no_duplicates_in_either_passes(self, base_df, cfg):
        result = layer.run(base_df, base_df.copy(), cfg)
        c = check(result, "duplicate_rows")
        assert c.status == Status.PASSED
        assert c.details["source_duplicates"] == 0
        assert c.details["target_duplicates"] == 0

    def test_equal_duplicate_counts_passes(self, base_df, cfg):
        dup_df = pd.concat([base_df, base_df.iloc[:2]], ignore_index=True)
        result = layer.run(dup_df, dup_df.copy(), cfg)
        c = check(result, "duplicate_rows")
        assert c.status == Status.PASSED

    def test_target_has_extra_duplicates_fails(self, base_df, cfg):
        tgt = pd.concat([base_df, base_df.iloc[:1]], ignore_index=True)
        result = layer.run(base_df, tgt, cfg)
        # row_count fails first → early exit; test with equal-length df
        src_dup = pd.concat([base_df, base_df.iloc[:1]], ignore_index=True)
        tgt_dup = pd.concat([base_df, base_df.iloc[:2]], ignore_index=True)
        # still row count mismatch; craft same-length frames
        src2 = pd.concat([base_df, base_df.iloc[:1]], ignore_index=True)  # 6 rows, 1 dup
        row = pd.DataFrame([{"id": 99, "name": "Zed", "score": 1.0}])
        tgt2 = pd.concat([base_df, row], ignore_index=True)               # 6 rows, 0 dups
        result2 = layer.run(src2, tgt2, cfg)
        c = check(result2, "duplicate_rows")
        assert c.status == Status.FAILED
        assert c.details["source_duplicates"] == 1
        assert c.details["target_duplicates"] == 0


